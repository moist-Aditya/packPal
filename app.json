{
  "expo": {
    "name": "Pack Pal",
    "slug": "pack-pal",
    "version": "1.0.0",
    "scheme": "pack-pal",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/android-icon-foreground.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/android-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aditya221210011.packpal"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e539d0f7-baae-4735-b86c-2e29a9442687"
      }
    }
  }
}
